# ─────────────────────────────────────────
# LEAN workspace + build artefacts
# ─────────────────────────────────────────
.lean/
backtests/
live/
results/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ─────────────────────────────────────────
# Environment / credentials — NEVER commit
# ─────────────────────────────────────────
.env
*.env
niblit_params.json
niblit_lean_signal.json

# ─────────────────────────────────────────
# Runtime / AI memory (Niblit)
# ─────────────────────────────────────────
data/
niblit/

# JSON runtime state (NOT configs)
*_state.json
*.jsonl
niblit_*.json
niblit_memory.json.backup

# Pickle / memory graphs
*.pkl

# Virtual environments
.venv/
niblit-env/

# Python deep cache
**/__pycache__/

# ─────────────────────────────────────────
# Android / Buildozer
# ─────────────────────────────────────────
.buildozer/
.buildozer/android/platform/python-for-android/

# Build outputs
*.apk
*.aab
*.dex

# ─────────────────────────────────────────
# Logs / temp
# ─────────────────────────────────────────
*.log

# ─────────────────────────────────────────
# macOS
# ─────────────────────────────────────────
.DS_Store

# ─────────────────────────────────────────
# IDE
# ─────────────────────────────────────────
.vscode/
.idea/

# ─────────────────────────────────────────
# KEEP IMPORTANT CONFIGS
# ─────────────────────────────────────────
!lean.json
!requirements.txt
!README.md

# Local environment overrides and backups; keep configuration templates
.env.*
*.env.*
!.env.example
!.env.*.example
!*.env.example
!*.env.template
!*.env.sample

# Additional local dependency, packaging, and test outputs
venv/
__pypackages__/
node_modules/
target/
.pytest_cache/
/.pytest_push_*/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.whl

# Trading state and local model/database assets
.niblit/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-journal
*.db-wal
*.db-shm
*.gguf
*.safetensors
*.onnx

# One-off root probes and editor backups
/_[!_]*
*.tmp
*.bak
*.bak.*
*.swp
*.swo
Thumbs.db
Desktop.ini
