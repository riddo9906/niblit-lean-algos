# ──────────────────────────────────────────────────────────────────────────────
# niblit-lean-algos — required environment variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Freqtrade / Binance (primary — replace QuantConnect) ─────────────────────
# Binance exchange API credentials (required for live trading with Freqtrade).
# Create keys at https://www.binance.com/en/my/settings/api-management
# Give "Enable Spot & Margin Trading" permission; DO NOT enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Freqtrade REST API server credentials (for ft_live.py status/control)
FT_API_HOST=127.0.0.1
FT_API_PORT=8080
FT_API_USER=freqtrader
FT_API_PASS=

# Telegram notifications (optional — configure in configs/freqtrade_config_*.json)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Niblit AI signal bridge ────────────────────────────────────────────────────
# Absolute path to the Niblit trading-brain signal file.
# Niblit writes this file; Freqtrade strategies read it.
# Default (if not set): /tmp/niblit_lean_signal.json
NIBLIT_SIGNAL_FILE=/tmp/niblit_lean_signal.json

# Maximum age of a signal before it is considered stale (seconds).
# Default: 300 (5 minutes)
NIBLIT_SIGNAL_MAX_AGE=300

# Minimum Niblit confidence to trigger an entry veto (0.0–1.0).
# Default: 0.55
NIBLIT_MIN_CONF=0.55

# Path for Freqtrade AI Master results JSON (read back by Niblit).
# Default: /tmp/niblit_ft_results.json
NIBLIT_RESULTS_FILE=/tmp/niblit_ft_results.json

# Trade reflection and market-memory event streams (JSONL append files).
NIBLIT_REFLECTION_FILE=/tmp/niblit_trade_reflection.jsonl
NIBLIT_EPISODES_FILE=/tmp/niblit_market_episodes.jsonl

# Governance gate coherence thresholds.
NIBLIT_SURVIVAL_COHERENCE=0.30
NIBLIT_CONSTRAINED_COHERENCE=0.45
NIBLIT_CAUTIOUS_COHERENCE=0.52
NIBLIT_MAX_ATTENTION_PRESSURE=0.85
NIBLIT_MIN_COGNITIVE_BUDGET=0.10
NIBLIT_MIN_HEALTH_MULTIPLIER=0.05

# Optional adaptive sizing weights (all default to 1.0).
NIBLIT_WEIGHT_CONFIDENCE=1.0
NIBLIT_WEIGHT_COHERENCE=1.0
NIBLIT_WEIGHT_AGREEMENT=1.0
NIBLIT_WEIGHT_RUNTIME_STABILITY=1.0
NIBLIT_WEIGHT_GOVERNANCE_STABILITY=1.0
NIBLIT_WEIGHT_EMERGENCE_INVERSE=1.0
NIBLIT_WEIGHT_ATTENTION_INVERSE=1.0
NIBLIT_WEIGHT_COGNITIVE_BUDGET=1.0
NIBLIT_WEIGHT_ATTENTION_AVAILABLE=1.0
NIBLIT_WEIGHT_MODEL_CONSENSUS=1.0
NIBLIT_WEIGHT_DISAGREEMENT_INVERSE=1.0

# ── GitHub (required for nibblebot workflows) ─────────────────────────────────
# Set automatically in GitHub Actions — only needed for local testing.
# GITHUB_TOKEN=ghp_...

# Enable GitHub Models LLM-enhanced reports (optional).
# GITHUB_MODELS_TOKEN=ghp_...
# USE_GH_MODEL_REPORTS=false

# ── Niblit Trading Runtime (Freqtrade adapter) ────────────────────────────────
# Backend selection: freqtrade or lean
NIBLIT_TRADING_BACKEND=freqtrade
# Execution mode: observe, paper, or live
NIBLIT_TRADING_MODE=observe

# Freqtrade REST API connection
NIBLIT_FREQTRADE_BASE_URL=http://127.0.0.1:8080
NIBLIT_FREQTRADE_USERNAME=
NIBLIT_FREQTRADE_PASSWORD=
NIBLIT_FREQTRADE_TOKEN=
NIBLIT_FREQTRADE_TIMEOUT_SECONDS=30
NIBLIT_FREQTRADE_DRY_RUN=true
NIBLIT_FREQTRADE_VERIFY_SSL=true
NIBLIT_FREQTRADE_MAX_RETRIES=3
NIBLIT_FREQTRADE_RETRY_BACKOFF_SECONDS=1
NIBLIT_FREQTRADE_ALLOW_EXECUTION=false

# Risk policy
NIBLIT_MAX_STAKE_PERCENTAGE=0.10
NIBLIT_MAX_OPEN_POSITIONS=5
NIBLIT_MAX_DAILY_LOSS=0.03
NIBLIT_MAX_LEVERAGE=1.0
NIBLIT_MIN_CONFIDENCE=0.50
NIBLIT_MAX_DECISION_AGE_SECONDS=300

# Market data (Phase 2 — real observe-mode MarketState)
# Freqtrade backend defaults to ccxt when unset. Use mock for unit tests.
NIBLIT_MARKET_DATA_PROVIDER=ccxt
NIBLIT_MARKET_DATA_EXCHANGE=binance
NIBLIT_MARKET_DATA_MARKET_TYPE=swap
NIBLIT_MARKET_DATA_TIMEFRAME=5m
NIBLIT_MARKET_DATA_CANDLE_LIMIT=200
NIBLIT_MARKET_DATA_MAX_AGE_SECONDS=90
NIBLIT_MARKET_DATA_TIMEOUT_SECONDS=20
NIBLIT_MARKET_DATA_ALLOW_NON_WHITELISTED=false

# Optional gated integration tests
# NIBLIT_RUN_FREQTRADE_INTEGRATION_TESTS=1
# NIBLIT_RUN_MARKET_DATA_INTEGRATION_TESTS=1

# Live trading acknowledgement (required for live mode)
# NIBLIT_LIVE_TRADING_ACKNOWLEDGEMENT=I_UNDERSTAND_LIVE_TRADING_RISK

# ── LEGACY: QuantConnect credentials (deprecated — kept for existing QC algos) ─
# QC_USER_ID=
# QC_API_CRED=

# ── LEGACY: QuantConnect algorithm overrides ──────────────────────────────────
# NIBLIT_SYMBOL=SPY
# NIBLIT_FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD
# NIBLIT_SA_SYMBOL=SPY
# NIBLIT_SA_META_FILE=/tmp/niblit_self_aware_state.json
